---
import GmLayout from '~/layouts/GmLayout.astro';
import EarlyRulesBadge from '~/components/EarlyRulesBadge.astro';
import Plate from '~/components/Plate.astro';
import RestrictedBand from '~/components/RestrictedBand.astro';
import { gmChapters, gmTabs } from '~/lib/chapters';
import { numeral } from '~/lib/nav';
import plate from '~/assets/plates/plate-gm-guide.webp';

const chapters = await gmChapters();
const tabs = await gmTabs();
---
<GmLayout title="GM's Guide" description="The Commander's copy: running Titans, Expeditions, and the dangers the squad cannot see." tabs={tabs}>
  <section class="sheet sheet--carbon" aria-labelledby="page-title">
    <RestrictedBand />
    <div class="runhead lbl"><span>Part V · GM's Guide</span><span>Commander's copy</span></div>
    <header class="rules-head">
      <p class="lbl eyebrow">Briefing</p>
      <h1 class="h1" id="page-title">GM's Guide</h1>
      <p class="lede carbon">The same manual, with the pages the squad never sees. Run the Titans honestly, keep the dice in the open, and let the table decide who comes home.</p>
    </header>
    <div class="gm-plate">
      <Plate
        number="Plate XIII"
        caption="The Commander over the map table, the night before the order goes out."
        label="A commander leaning on a large lit map table covered in markers, in a candlelit hall hung with Wings of Freedom banners"
        art="gm-opener"
        image={plate}
        maxWidth={720}
      />
    </div>
    <ul class="folders">
      {chapters.map((chapter, i) => (
        <li class="folder">
          <a href={`/gm/${chapter.id}/`} data-tab={`File ${numeral(i)}`}>
            <b>{chapter.data.title}{chapter.data.earlyRules && <EarlyRulesBadge />}</b>
            <span>{chapter.data.summary}</span>
          </a>
        </li>
      ))}
      <li class="folder">
        <a href="/gm/titan-dossiers/" data-tab="Dossiers">
          <b>Titan Dossiers</b>
          <span>Every Titan in full, including the values an Abnormal hides until a Read.</span>
        </a>
      </li>
    </ul>
  </section>
</GmLayout>

---
import '~/styles/compendium.css';
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import CompendiumIndex, { type FilterGroup } from '~/components/CompendiumIndex.astro';
import TalentCard from '~/components/TalentCard.astro';
import { COMPENDIUM_TABS } from '~/lib/compendium';

const talents = (await getCollection('talents')).sort((a, b) => a.data.name.localeCompare(b.data.name, 'en'));

function tally(lists: { slug: string; name: string; order: number }[][]) {
  const found = new Map<string, { value: string; label: string; count: number; order: number }>();
  for (const list of lists) {
    for (const item of list) {
      const row = found.get(item.slug) ?? { value: item.slug, label: item.name, count: 0, order: item.order };
      row.count += 1;
      found.set(item.slug, row);
    }
  }
  return [...found.values()].sort((a, b) => a.order - b.order).map(({ value, label, count }) => ({ value, label, count }));
}

const groups: FilterGroup[] = [
  {
    key: 'type',
    label: 'Type',
    options: [
      { value: 'dice', label: 'Dice Talents', count: talents.filter((t) => t.data.kind === 'dice').length },
      { value: 'rule', label: 'Rule Talents', count: talents.filter((t) => t.data.kind === 'rule').length },
    ],
  },
  { key: 'specialty', label: 'Specialty', options: tally(talents.map((t) => t.data.specialties)) },
  { key: 'attribute', label: 'Attribute', options: tally(talents.map((t) => t.data.attributes)) },
];
---
<BaseLayout
  title="Talents"
  description="Every Talent in Wings of Freedom, filterable by Specialty, type, and attribute."
  section="compendium"
  tabs={COMPENDIUM_TABS}
  tabsLabel="Compendium sections"
>
  <section class="sheet" aria-labelledby="page-title">
    <div class="runhead lbl"><span>Part III · Compendium</span><span>Talents</span></div>
    <CompendiumIndex
      id="talents"
      groups={groups}
      total={talents.length}
      singular="Talent"
      plural="Talents"
      searchLabel="Search Talents"
      searchPlaceholder="Search by name or Action"
    >
      <div slot="head">
        <p class="lbl eyebrow">Compendium</p>
        <h1 class="h1" id="page-title">Talents</h1>
        <p class="lede">Practiced skills that add dice to the rolls they name, or change a rule when it matters.</p>
      </div>
      <div class="cards">
        {talents.map((talent) => <TalentCard talent={talent} />)}
      </div>
    </CompendiumIndex>
  </section>
</BaseLayout>

---
import '~/styles/rules.css';
import BaseLayout from '~/layouts/BaseLayout.astro';
import BoxPair from '~/components/BoxPair.astro';
import CoreTable from '~/components/CoreTable.astro';
import DiceKey from '~/components/DiceKey.astro';
import FieldQuote from '~/components/FieldQuote.astro';
import GrabCountdown from '~/components/GrabCountdown.astro';
import HarmTrack from '~/components/HarmTrack.astro';
import MarginNote from '~/components/MarginNote.astro';
import MindPaths from '~/components/MindPaths.astro';
import PoolBuild from '~/components/PoolBuild.astro';
import PositionShapes from '~/components/PositionShapes.astro';
import PositionsMap from '~/components/PositionsMap.astro';
import PushSteps from '~/components/PushSteps.astro';
import RoundDiagram from '~/components/RoundDiagram.astro';
import RuleBox from '~/components/RuleBox.astro';
import SectionHead from '~/components/SectionHead.astro';
import StepFlow from '~/components/StepFlow.astro';
import Subsection from '~/components/Subsection.astro';
import { fallFlow, gasRollFlow, wearFlow } from '~/lib/gear-tables';
import { attackSteps } from '~/lib/skirmish-tables';
import { REFERENCE_TABS } from '~/lib/nav';

/**
 * One sheet for the table. Every table and drawing here is built from the shared
 * data through the same modules the chapters use, so nothing on this page can
 * drift from a chapter. The anchors #circumstances, #called-rolls, #passive-rolls,
 * #pushing-your-luck, #covering, and #help are the ones those rendered tables link
 * to, so each has to keep its id.
 */
const SECTIONS = [
  { id: 'the-roll', title: 'The Roll', note: 'The pool, what a roll needs, called rolls' },
  { id: 'circumstances', title: 'Circumstances', note: 'The seven-step ladder' },
  { id: 'pushing-your-luck', title: 'Push and Cover', note: 'Five steps, and who pays' },
  { id: 'stress', title: 'Stress and Fear', note: 'Gains, losses, and both tables' },
  { id: 'help', title: 'Bonus Dice and Help', note: 'Every source, and the cap of 4' },
  { id: 'the-round', title: 'The Round', note: 'Cards, turns, attack and Reaction' },
  { id: 'positions', title: 'Positions and Moves', note: 'Positions, the Flight, Momentum, Anchors' },
  { id: 'titans', title: 'Titans and the Grab', note: 'Cutting one down, and getting out' },
  { id: 'harm', title: 'Harm, Down, and Death', note: 'Boxes, time limits, the end steps' },
  { id: 'gear', title: 'Gear and Gas', note: 'Wear, the Gas Roll, falls, carrying' },
  { id: 'skirmish', title: 'The Skirmish', note: 'The exchange, weapons, Parley' },
];
---
<BaseLayout
  title="Quick Reference"
  description="Every procedure, ladder, and table a Wings of Freedom table reaches for during play, on one sheet."
  section="reference"
  tabs={REFERENCE_TABS}
  tabsLabel="Reference sections"
>
  <section class="sheet sheet--light" aria-labelledby="page-title">
    <div class="runhead lbl"><span>Part IV · Reference</span><span>Quick Reference</span></div>
    <header class="rules-head">
      <p class="lbl eyebrow">Reference</p>
      <h1 class="h1" id="page-title">Quick Reference</h1>
      <p class="lede">Every procedure, ladder, and table you reach for mid-fight, on one sheet.</p>
    </header>
    <div class="rules-body">

      <FieldQuote cite="Survey Corps manual, inside the front cover">Keep this page open on the table. The rest of the book is for the ride out.</FieldQuote>

      <nav class="qr-contents wide" aria-labelledby="qr-contents-title">
        <p class="lbl" id="qr-contents-title">On this sheet</p>
        <ol>
          {SECTIONS.map((section, i) => (
            <li>
              <a href={`#${section.id}`}>
                <span class="n num" aria-hidden="true">{i + 1}</span>
                <span class="title">{section.title}</span>
                <span class="note">{section.note}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <SectionHead id="the-roll" eyebrow="1">The Roll</SectionHead>

      <p>Build a pool, roll it, count the sixes. <b>Every 6 is a success</b> — Titan Dice alone on a <b>5 or 6</b>.</p>

      <DiceKey />

      <Subsection title="Building the pool" note="Seven steps, in order" id="the-pool">
        <PoolBuild fig="Fig. 1" />
      </Subsection>

      <Subsection title="Finishing a roll" note="Four steps, in order" id="finishing">
        <ol>
          <li><b>Count every 6.</b> A roll needs <b>1 success</b> unless its rule names a number. The GM never moves that number.</li>
          <li><b>Resolve any Stress Response,</b> at your Stress after the Push.</li>
          <li><b>Apply the effect,</b> or the one staked cost.</li>
          <li><b>Apply wear:</b> 1 point if the roll was Pushed and any Gear Die shows 1.</li>
        </ol>
        <p><b>Each success is used once</b> — except a Reaction's.</p>
      </Subsection>

      <CoreTable table="roll-exceptions" />

      <Subsection title="Called rolls" id="called-rolls">
        <p>No rule, in doubt, and a cost for failing — all three. Named before the dice: the entry or attribute, the step, the stakes. <b>It needs 1 success</b>, and nothing changes once the dice fall.</p>
        <p><b>In a fight it is the last resort,</b> after a Catalog entry and an improvised act, and only if it changes nothing the fight tracks. It never stands in for a Reaction.</p>
        <p id="passive-rolls"><b>A passive roll</b> is made for you out of sight, outside a fight — no stakes, no Help, no Push.</p>
      </Subsection>

      <CoreTable table="called-roll-costs" />

      <p><b>Never staked:</b> a Critical Injury, Death Roll, Scar, Grief, Fear Roll, Stress relief, healing, a care window, or any Titan, Foe, or table result.</p>

      <SectionHead id="circumstances" eyebrow="2">Circumstances</SectionHead>

      <CoreTable table="circumstances" />

      <ul>
        <li><b>One step per roll,</b> named with the stakes and before Bonus Dice.</li>
        <li><b>Plus steps are Bonus Dice</b> under the cap of 4; <b>minus steps are penalties</b> after it, base dice only, never below 1.</li>
        <li><b>Needs never change,</b> and the step is fixed once named.</li>
        <li><b>Standard in a fight,</b> and <b>it never reaches the Titan.</b></li>
      </ul>

      <SectionHead id="pushing-your-luck" eyebrow="3">Push and Cover</SectionHead>

      <PushSteps fig="Fig. 2" />

      <BoxPair>
      <RuleBox variant="stop" title="You cannot Push when" icon="ph:prohibit">
        <ul>
          <li>any Stress Die showed a 1, on the roll or after an earlier Push of it;</li>
          <li>the roll's rule forbids it, as the Death Roll and the first two Trials do;</li>
          <li>the roll is a passive roll, or is not an attribute roll;</li>
          <li>you have already Pushed it as often as you are allowed: once, unless a Talent allows more;</li>
          <li>a state or result you hold forbids it, as being Down does.</li>
        </ul>
      </RuleBox>
      <RuleBox variant="gas" title="What a Push costs" icon="ph:wind">
        <p>1 Stress and a new Stress Die, unless a comrade Covers. A Gear Die showing 2 to 5 rolls again; a 1 is locked and a 6 stays. Any 1 showing when the roll is final wears the item by <b>1 point</b>, one point however many show it, and any wear ruins a Blade Set.</p>
        <p>A Push of a roll whose gear item is ODM Gear makes that round's <b>Gas Roll three dice</b> instead of two, however many of the round's rolls you Pushed with it.</p>
      </RuleBox>
      </BoxPair>

      <Subsection title="Covering" id="covering">
        <p>A player character who is not Down, not Pushing, and in the Pushing soldier's zone or an adjacent zone takes the Stress instead, declared after the Push, before any re-roll, one Coverer only, and refusable.</p>
        <p><b>The Coverer gains 1 Stress;</b> the Pusher gains none and adds no Stress Die. Everything else stands: a 1 is still <em>their</em> Stress Response, their gear still wears. Not an action, and a Squadmate never Covers.</p>
      </Subsection>

      <SectionHead id="stress" eyebrow="4">Stress and Fear</SectionHead>

      <CoreTable table="stress-changes" />

      <p><b>Minimum Stress</b> is your number of Scars, and no loss goes below it. A Stress Die on 1 sets off a Stress Response — one per roll at most. <b>The dice never cause a Fear Roll.</b></p>

      <MindPaths fig="Fig. 3" />

      <CoreTable table="stress-responses" />

      <MarginNote>Rally clears one lasting Stress Response or pending Fear result for each success, and never lowers Stress: <a href="/guide/wounds-and-fear/#rally">Wounds &amp; Fear</a>.</MarginNote>

      <CoreTable table="fear-triggers" />

      <CoreTable table="fear-rolls" />

      <p>One per soldier per event, every total read from Stress, Resolve, and Scars <em>as they stood then</em>. A Down soldier makes none, and a Drive shrugs off the whole result once a session.</p>

      <SectionHead id="help" eyebrow="5">Bonus Dice and Help</SectionHead>

      <CoreTable table="bonus-dice" />

      <ul>
        <li><b>Listed sources only,</b> declared before the dice and never added later.</li>
        <li><b>Cap of 4.</b> Over it you choose, and what you leave out is not spent.</li>
        <li><b>Help</b> adds 1 die, from up to 3 comrades who never roll and take no Stress Response.</li>
        <li><b>It spends the helper's action</b> in a fight, from the roller's zone or an adjacent zone. Elsewhere, whatever the calling rule says.</li>
      </ul>

      <SectionHead id="the-round" eyebrow="6">The Round</SectionHead>

      <RoundDiagram fig="Fig. 4" />

      <ul>
        <li><b>One move and one action,</b> in either order, never split.</li>
        <li><b>A Reaction spends a whole turn</b> — your earliest with both parts unspent — and one spent in advance arrives already spent.</li>
        <li><b>Once per round, never banked.</b> What you decline stays only for Help and Reactions.</li>
        <li><b>Not actions:</b> Reactions, Pushing, Covering, declaring Bonus Dice, spending Openings.</li>
      </ul>

      <Subsection title="Attack and Reaction" note="One procedure for every attack" id="attack-and-reaction">
        <ol>
          <li><b>The attack rolls and finishes first.</b> Its successes are the <b>Severity</b>. A Titan or Foe never Pushes.</li>
          <li><b>Each target decides,</b> knowing the Severity, and the reacting side Pushes last.</li>
          <li><b>Each Reaction success cancels one.</b> What is left is that target's <b>Net Successes</b>, and it lands on 1 or more.</li>
          <li><b>No Reaction cancels nothing,</b> and an attack that scored 0 whiffs against everyone.</li>
        </ol>
        <p><b>One Reaction per enemy per round,</b> cancelling against every later attack that enemy makes on you, never used up. <b>Titans cannot be blocked</b> — a dodge is the only answer.</p>
      </Subsection>

      <SectionHead id="positions" eyebrow="7">Positions and Moves</SectionHead>

      <PositionsMap fig="Fig. 5" rating="wooded" />

      <CoreTable table="positions" />

      <RuleBox variant="stop" title="On Body is on it. Blind Spot is not." icon="ph:tree-evergreen">
        <p><b>On Body</b> means hooked into the Titan or standing on it, anywhere but the Nape. <b>Blind Spot</b> means anchored to terrain behind it, a tree or a roof, out of its sight with its Nape in reach and <em>not touching it</em>.</p>
        <p>So steam at a Regeneration fill burns the soldiers On Body and not the Nape strikers, a Jam does not drop a soldier standing on an Urban roof, and ground with nothing to anchor to has no Blind Spot at all.</p>
      </RuleBox>

      <PositionShapes fig="Fig. 6" />

      <CoreTable table="position-steps" />

      <ul>
        <li><b>One Position per Focus Titan and per corpse.</b> Holding one is the test for being in the fight.</li>
        <li><b>A move is a zone step to an adjacent zone or an attachment step in your own zone,</b> the only way you change your own Position.</li>
        <li><b>Close to one, loose from the other.</b> Coming to On Body or Blind Spot on one makes any other's In Reach.</li>
        <li><b>A fall from the body</b> lands you In Reach. From further out, your Position holds.</li>
      </ul>

      <Subsection title="What changes a Position" id="what-changes-a-position">
        <p><b>An action never does.</b> Not the Nape strike, the Body Part strike, Break Attention, Draw Attention, Read, Heave, Treat Injury, Rally, or anything else you roll. Neither does a Titan turning its Attention on you. Only your own move, and this closed list.</p>
        <CoreTable table="position-changes" />
      </Subsection>

      <Subsection title="The Flight" id="the-flight">
        <ul>
          <li><b>Every ODM move in a fight is a Flight:</b> roll Fly on your own harness, needing no successes.</li>
          <li><b>The step happens whatever the dice say.</b> The roll decides what it was <em>worth</em>.</li>
          <li><b>Each success is 1 Momentum,</b> up to the Anchors of the zone you started in. <b>No successes and you are marked loudest,</b> from any Position, Distant included.</li>
          <li><b>Not Flights:</b> letting go, a step on foot, a mounted step, being carried, and a Fear Roll's forced step. A move made under a <em>retreat</em> is one.</li>
        </ul>
      </Subsection>

      <CoreTable table="momentum" />

      <CoreTable table="anchors" />

      <ul>
        <li><b>Momentum is capped by the Anchors of the zone you're in,</b> and you <b>lose all of it at the end of any round you made no ODM move in</b>. You spend it in your own turn; the GM never grants, spends, or takes a point.</li>
        <li><b>A zone's Anchors are never restored.</b> A wreck takes one rating step off the Titan's own zone, landed or whiffed; a falling body does the same to the zone it lands in. Caps fall with the zone.</li>
        <li><b>At Open, nobody in that zone holds Momentum,</b> but Flights still fly, and every soldier Anchored in a zone that becomes Open <b>lands Ground with no fall</b>, whatever stands there, a provisional rule not yet settled. A wreck to Open also <b>removes that zone's Blind Spot step</b>, turning a standing Titan's Blind Spot there into On Body.</li>
        <li><b>The mounted charge:</b> a mounted move that enters or leaves a zone holding a Focus Titan may mark one such Titan loudest, your choice, once per move. Never rolled, not ODM use.</li>
      </ul>

      <SectionHead id="titans" eyebrow="8">Titans and the Grab</SectionHead>

      <CoreTable table="titan-sizes" />

      <CoreTable table="titan-attack-dice" />

      <MarginNote stamp="Read twice">The soldier holding a Titan's Attention cannot make a Nape strike against it. Somebody has to be the one it is looking at.</MarginNote>

      <ul>
        <li><b>Frenzy.</b> Every Focus Titan starts a fight at 0 and gains <b>1 at the end of every third round, to a cap of 3</b>. It is added to its behavior roll, and every table runs from terrorising to killing, so <b>it gets worse the longer you take</b>. A result past the table's last entry reads as that entry.</li>
        <li><b>It turns on whoever it can reach.</b> If the soldier holding its Attention is not standing where the rolled behavior works, it takes the next candidate down the ladder who is, and its Attention goes with them. Only with nobody reachable does the behavior fall back.</li>
      </ul>

      <CoreTable table="attention-ladder" />

      <CoreTable table="attention-marks" />

      <CoreTable table="body-parts" />

      <Subsection title="Cutting it down" id="cutting">
        <ul>
          <li><b>A Body Part strike</b> adds each success to the part's count; at its Toughness the part moves one state toward Broken and the count resets.</li>
          <li><b>A Nape strike</b> needs Blind Spot, not holding its Attention, not Grabbed, working ODM Gear unless grounded, and no retreat. <b>Reach the Nape Depth and it dies; fall short and each success becomes 1 Opening.</b></li>
        <li><b>The strike leaves you at Blind Spot.</b> Hooking in counts for the Attention Ladder only. Draw its Attention onto yourself and you cannot strike again until the Attention moves.</li>
          <li><b>Openings</b> wait for a comrade — <b>never for the soldier who made them</b> — at 1 Bonus Die each.</li>
          <li><b>A grounded Titan</b> gives Nape strikes 2 Bonus Dice, needs no working ODM Gear, and puts the close steps on foot.</li>
          <li><b>Regeneration</b> fills 1 a round. Full: Openings erased, counts to 0, the most damaged part one state toward Intact, steam on everyone On Body, clock empty.</li>
        </ul>
      </Subsection>

      <CoreTable table="steam" />

      <GrabCountdown fig="Fig. 7" />

      <CoreTable table="grab-escapes" />

      <SectionHead id="harm" eyebrow="9">Harm, Down, and Death</SectionHead>

      <HarmTrack fig="Fig. 8" />

      <CoreTable table="harm-kinds" />

      <p><b>A Titan attack is always a Critical Injury and never damage,</b> +1 to its roll per Net Success beyond the first. Steam, a falling Titan, and corpse heat are <em>not</em> Titan attacks. The four injury tables are in <a href="/guide/wounds-and-fear/#the-four-tables">Wounds &amp; Fear</a>.</p>

      <CoreTable table="injury-location" />

      <BoxPair>
      <RuleBox title="While you are Down" icon="ph:hand">
        <p>Your turns still happen — move only — and still count for a time limit or a Grab countdown. You can be treated, Rallied, and lifted, and you make Death Rolls.</p>
      </RuleBox>
      <RuleBox variant="stop" title="Down forbids" icon="ph:prohibit">
        <p>Every action, Help included; Push, Help, Cover, and Reactions; every attribute roll but the Death Roll, so no Stress Dice and no Stress Response; and the Fear Roll.</p>
      </RuleBox>
      </BoxPair>

      <CoreTable table="time-limits" />

      <p><b>The Death Roll:</b> Strength, plus one Talent that names it, minus that wound's penalty — and nothing else. One roll per wound, 1 success, and <b>the first failure kills you</b>.</p>

      <CoreTable table="death-roll-outcomes" />

      <CoreTable table="treat-injury-uses" />

      <CoreTable table="engagement-end" />

      <SectionHead id="gear" eyebrow="10">Gear and Gas</SectionHead>

      <p>An item's <b>Gear Dice are its current rating</b>, one item per roll. <b>At 0 it counts as not had.</b></p>

      <StepFlow id="fig-wear" fig="Fig. 9" title="From a Push to a Jam" steps={wearFlow()} />

      <StepFlow id="fig-gas" fig="Fig. 10" title="The Gas Roll, and running dry" steps={gasRollFlow()} />

      <MarginNote stamp="Read twice">Dry is not Jammed. Dry, the harness is whole, one canister fixes it, and it never drops you. Jammed, only a repair or a new harness will do, and it drops you out of the air.</MarginNote>

      <CoreTable table="gear-items" />

      <StepFlow id="fig-fall" fig="Fig. 11" title="A fall, band to landing" steps={fallFlow()} />

      <CoreTable table="fall-bands" />

      <CoreTable table="fall-damage" />

      <CoreTable table="carrying" />

      <SectionHead id="skirmish" eyebrow="11">The Skirmish</SectionHead>

      <p><b>Engaged</b> or <b>Apart</b>, held separately for each Foe, and only a move changes it. A Skirmish has no Positions, no Anchor Rating, no ODM move, and nobody airborne.</p>

      <StepFlow id="fig-skirmish-attack" fig="Fig. 12" title="An attack and its answer" steps={attackSteps()} />

      <ul>
        <li><b>Block</b> (Strength, Blade Set) answers a Fight attack only. <b>Dodge</b> (Agility, ODM or horse) answers a Fight attack or a shot.</li>
        <li><b>Damage is the weapon's, +1 per Net Success beyond the first</b> — so half a Reaction is worth having.</li>
        <li><b>A Foe at 0 Health is out.</b> Foes have no Critical Injuries, no Stress, and no Down state.</li>
        <li><b>A group breaks</b> when its Foes out reach its Grit, at the latest.</li>
      </ul>

      <CoreTable table="skirmish-actions" />

      <CoreTable table="skirmish-weapons" />

      <CoreTable table="parley-asks" />

      <CoreTable table="skirmish-rolls" />

    </div>
  </section>
</BaseLayout>

<style>
  .qr-contents {
    padding: 12px 0 14px;
    border-top: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
  }
  .qr-contents > .lbl {
    color: var(--ink-2);
  }
  .qr-contents ol {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 2px 28px;
    margin: 8px 0 0;
    padding: 0;
  }
  .qr-contents a {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: baseline;
    padding: 5px 0;
    color: var(--ink);
    text-decoration: none;
  }
  .qr-contents a:hover .title {
    text-decoration: underline;
  }
  .qr-contents .n {
    color: var(--ink-2);
    font-size: var(--fs-sm);
  }
  .qr-contents .title {
    font-weight: 600;
  }
  .qr-contents .note {
    grid-column: 2;
    color: var(--ink-2);
    font-size: var(--fs-sm);
  }
</style>

---
import { Icon } from 'astro-icon/components';
import OpenerLayout from '~/layouts/OpenerLayout.astro';
import { REFERENCE_TABS } from '~/lib/nav';
import plate from '~/assets/plates/plate-reference.webp';

const items = [
  { href: '/reference/glossary/', icon: 'ph:book-open', title: 'Glossary', summary: 'Every game term in the manual, defined in a sentence or two.' },
  { href: '/reference/quick-reference/', icon: 'ph:list-checks', title: 'Quick Reference', summary: 'The dice, the Push, and the numbers you reach for mid-fight, on one sheet.' },
  { href: '/reference/dice-tray/', icon: 'ph:dice-five', title: 'Dice Tray', summary: 'A field box for rolling your pool and Pushing it, right on the page.' },
];
---
<OpenerLayout
  title="Reference"
  description="The glossary, a quick reference, and the Dice Tray."
  section="reference"
  tabs={REFERENCE_TABS}
  tabsLabel="Reference sections"
  runhead={['Part IV · Reference', 'At the table']}
  eyebrow="Part IV"
  lede="What you reach for at the table, without turning back through the chapters."
  plate={{
    number: 'Plate V',
    caption: 'Standard Issue, laid out for inspection.',
    label: 'A soldier’s kit laid out on a green blanket: folded cloak, harness straps, gas canister, canteen, three blades, ODM handles, rations, compass, and flare pistol',
    art: 'reference-opener',
    image: plate,
    maxWidth: 560,
  }}
  stamp="Keep handy"
>
  <ul class="contents">
    {items.map((item) => (
      <li>
        <a href={item.href}>
          <span class="cnum" aria-hidden="true"><Icon name={item.icon} class="arrow" /></span>
          <span class="ctitle">{item.title}</span>
          <span class="csum">{item.summary}</span>
          <span class="cmeta lbl">Open</span>
        </a>
      </li>
    ))}
  </ul>
</OpenerLayout>

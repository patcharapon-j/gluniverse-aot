  { href: '#your-first-roll', title: 'Your first roll', summary: 'Build a pool, roll it, count the sixes.', meta: 'Step 1' },
  { href: '#pushing-your-luck', title: 'Pushing your luck', summary: 'A second chance, bought with Stress.', meta: 'Step 2' },
  { href: '#your-soldier', title: 'Your soldier in one minute', summary: 'Attributes, a Specialty, Talents, and kit.', meta: 'Step 3' },
  { href: '#your-first-titan', title: 'Your first Titan', summary: 'One fight, played through from the first move.', meta: 'Step 4' },
  { href: '#where-to-go-next', title: 'Where to go next', summary: 'The chapters, the Compendium, and the Dice Tray.', meta: 'Step 5' },
];

const next = [
  {
    href: '/guide/',
    icon: 'ph:book-open-text',
    title: "The Player's Guide",
    summary: 'Every rule a soldier needs, in seven chapters. Start with The Rules of Play, then Making Your Soldier.',
  },
  {
    href: '/compendium/',
    icon: 'ph:cards',
    title: 'The Compendium',
    summary: 'Every Specialty, Talent, action, Titan, and piece of kit, filed for the table.',
  },
  {
    href: '/reference/dice-tray/',
    icon: 'ph:dice-five',
    title: 'The Dice Tray',
    summary: 'Roll a pool and Push it on the page. Every "Try this roll" button on this site opens it.',
  },
  {
    href: '/reference/quick-reference/',
    icon: 'ph:list-checks',

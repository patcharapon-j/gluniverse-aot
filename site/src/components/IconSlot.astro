---
/**
 * A game icon slot, named by meaning in the icon inventory's families: `attr-agility`,
 * `specialty-slayer`, `talent-dice`. Put `src/assets/icons/<name>.webp` in place and the
 * slot shows that icon. Until then it draws its family's empty stamp frame (Talents keep
 * their drawn placeholder symbols). Always decorative: the text beside it carries the meaning.
 *
 * The approved icons are 1024 px squares. They live under `src/` rather than `public/` so
 * astro:assets can serve each slot a copy at the size it is actually drawn: shipped whole
 * they are about 100 KB each, and a page such as the Glossary shows twenty of them.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  size?: 'sm' | 'md' | 'lg';
}
const { name, size = 'md' } = Astro.props;
const family = name.slice(0, name.indexOf('-'));

const ICONS = import.meta.glob<{ default: ImageMetadata }>('../assets/icons/*.webp', { eager: true });
const art = ICONS[`../assets/icons/${name}.webp`]?.default ?? null;

/** The slot's drawn size in px, matched to the CSS box. Icons are served at twice it. */
const PX: Record<NonNullable<Props['size']>, number> = { sm: 20, md: 40, lg: 52 };
const px = PX[size];

/** Frame outlines per family, on a 40 unit square (ADR-0023: a fixed frame per family). */
const FRAMES: Record<string, string> = {
  attr: 'M20 2.5 35.2 11.25v17.5L20 37.5 4.8 28.75v-17.5z',
  specialty: 'M10 4h20l6 6v20l-6 6H10l-6-6V10z',
};
const frame = FRAMES[family] ?? 'M20 3a17 17 0 1 1-.01 0z';
---
<span class:list={['icon-slot', `icon-slot--${size}`]} data-icon={name} aria-hidden="true">
  {art ? (
    <Image src={art} alt="" width={px * 2} height={px * 2} loading="lazy" decoding="async" />
  ) : family === 'talent' ? (
    <svg viewBox="0 0 40 40"><use href={`#${name}`} /></svg>
  ) : (
    <svg viewBox="0 0 40 40"><path class="icon-slot-frame" d={frame} /></svg>
  )}
</span>

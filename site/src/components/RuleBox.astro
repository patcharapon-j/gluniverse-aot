---
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  variant?: 'stop' | 'gas' | 'plain';
  icon?: string;
}
const { title, variant = 'plain', icon } = Astro.props;
---
<div class:list={['box', variant !== 'plain' && `box--${variant}`]}>
  <h3>{icon && <Icon name={icon} aria-hidden="true" />}{title}</h3>
  <slot />
</div>

---
/** A drafted rear view of a Titan beside a 1.7 m soldier, scaled to its Size Class. */
interface Props {
  name: string;
  height: string;
}
const { name, height } = Astro.props;
const [lo = 6, hi = 10] = (height.match(/\d+(?:\.\d+)?/g) ?? []).map(Number);
const ground = 262;
const figureTop = 85;
const pxPerM = (ground - figureTop) / ((lo + hi) / 2);
const y = (m: number) => ground - m * pxPerM;
const step = hi <= 6 ? 1 : hi <= 12 ? 2 : 3;
const ticks = Array.from({ length: Math.floor(hi / step) + 1 }, (_, i) => i * step);
const soldierScale = (1.7 * pxPerM) / 38.4;
const mono = 'Courier Prime, Courier New, monospace';
---
<svg viewBox="0 0 320 290" role="img" aria-label={`${name}, ${height} tall, drawn from behind beside a soldier of 1.7 m, with its eyes, Nape, arms, and legs numbered`}>
  <g font-family={mono} font-size="9" fill="#5C5343">
    <line x1="34" y1={y(hi)} x2="34" y2={ground} stroke="#29241D" stroke-width="1.2" />
    <rect x="36" y={y(hi)} width="5" height={(hi - lo) * pxPerM} fill="#8B2A21" opacity=".55" />
    {ticks.map((m) => (
      <Fragment>
        <line x1="28" y1={y(m)} x2="34" y2={y(m)} stroke="#29241D" stroke-width="1" />
        <text x="25" y={y(m) + 3} text-anchor="end">{m === ticks[ticks.length - 1] ? `${m} m` : m}</text>
      </Fragment>
    ))}
    <text x="46" y={y(hi) - 6} fill="#8B2A21">{height}</text>
  </g>
  <line x1="30" y1={ground} x2="312" y2={ground} stroke="#29241D" stroke-width="1.5" />
  <g fill="url(#hatch)" stroke="#29241D" stroke-width="1.3" stroke-linejoin="round">
    <path d="M128 132 112 136 100 214 114 216 126 150Z" />
    <path d="M202 132 218 136 230 214 216 216 204 150Z" />
    <path d="M136 194 162 198 158 262 138 262Z" />
    <path d="M168 198 194 194 192 262 172 262Z" />
    <path d="M128 128Q165 120 202 128L196 196Q165 204 134 196Z" />
    <rect x="157" y="116" width="16" height="14" />
    <ellipse cx="165" cy="104" rx="16" ry="19" />
  </g>
  <rect x="155" y="115" width="20" height="14" fill="none" stroke="#8B2A21" stroke-width="1.6" stroke-dasharray="3 2" />
  <g fill="#29241D" transform={`translate(270 ${ground}) scale(${soldierScale.toFixed(3)}) translate(-270 -${ground})`}>
    <circle cx="270" cy="227" r="3.4" />
    <path d="M266 231h8l1.5 13h-2l-1 18h-2.5l-1-10-1 10h-2.5l-1-18h-2z" />
  </g>
  <text x="270" y="278" text-anchor="middle" font-family={mono} font-size="9" fill="#5C5343">1.7 m</text>
  <g stroke="#29241D" stroke-width=".8" fill="none">
    <path d="M180 98 230 88" /><path d="M175 122 230 122" /><path d="M104 196 78 188" /><path d="M226 196 254 188" /><path d="M146 240 92 240" /><path d="M184 240 226 246" />
  </g>
  <g fill="#29241D"><circle cx="180" cy="98" r="2" /><circle cx="175" cy="122" r="2" /><circle cx="104" cy="196" r="2" /><circle cx="226" cy="196" r="2" /><circle cx="146" cy="240" r="2" /><circle cx="184" cy="240" r="2" /></g>
  <g font-family={mono} font-size="9" font-weight="700" text-anchor="middle" fill="#29241D">
    <g fill="#ECE5D1" stroke="#29241D" stroke-width="1"><circle cx="238" cy="88" r="8" /><circle cx="238" cy="122" r="8" stroke="#8B2A21" stroke-width="1.6" /><circle cx="70" cy="188" r="8" /><circle cx="262" cy="188" r="8" /><circle cx="84" cy="240" r="8" /><circle cx="234" cy="247" r="8" /></g>
    <text x="238" y="91">1</text><text x="238" y="125" fill="#8B2A21">2</text><text x="70" y="191">3</text><text x="262" y="191">4</text><text x="84" y="243">5</text><text x="234" y="250">6</text>
  </g>
</svg>
<ul class="legend" aria-hidden="true">
  <li><b>1</b>Eyes</li>
  <li class="nape"><b>2</b>Nape</li>
  <li><b>3</b>Left Arm</li>
  <li><b>4</b>Right Arm</li>
  <li><b>5</b>Left Leg</li>
  <li><b>6</b>Right Leg</li>
</ul>

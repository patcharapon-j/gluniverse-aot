---
import type { ChapterLink } from '~/lib/chapters';

interface Props {
  prev?: ChapterLink;
  next?: ChapterLink;
}
const { prev, next } = Astro.props;
---
{(prev || next) && (
  <nav class="chapter-nav" aria-label="Previous and next chapter">
    {prev && <a class="prev" href={prev.href}><span class="lbl">Previous</span><b>{prev.title}</b></a>}
    {next && <a class="next" href={next.href}><span class="lbl">Next</span><b>{next.title}</b></a>}
  </nav>
)}

---
import type { CollectionEntry } from 'astro:content';
import IconSlot from './IconSlot.astro';
import GlossText from './GlossText.astro';
import { PAGE_ANCHORS } from '~/lib/core-tables';
import { glossifier } from '~/lib/glossify';

interface Props {
  action: CollectionEntry<'actions'>;
  /** Player's Guide chapter titles by slug. */
  chapters: Map<string, string>;
}
const { action, chapters } = Astro.props;
const a = action.data;

const pages = a.pages.map((ref) => {
  const [slug, anchor] = ref.split('#');
  const title = chapters.get(slug);
  if (!title) throw new Error(`ActionCard: "${a.name}" points to no Player's Guide chapter "${slug}".`);
  if (!anchor) return { href: `/guide/${slug}/`, label: title };
  const label = PAGE_ANCHORS[`#${anchor}`];
  if (!label) throw new Error(`ActionCard: no label for the anchor "#${anchor}".`);
  return { href: `/guide/${slug}/#${anchor}`, label: `${title}: ${label}` };
});

const search = [a.name, a.kind.name, a.rollLabel, ...a.does, ...a.diceTalents.map((t) => t.name), ...a.ruleTalents.map((t) => t.name)].join(' ').toLowerCase();

// Glossary pop-ups on the first use of each term on this card, in reading order.
const gloss = glossifier();
const gear = gloss(a.gear);
const requires = a.requires.map((r) => gloss(r));
const needs = gloss(a.needs);
const does = a.does.map((d) => gloss(d));
const help = gloss(a.help);
---
<article
  class="card card--action"
  aria-labelledby={action.id}
  data-cmp-item
  data-search={search}
  data-f-kind={a.kind.slug}
  data-f-attribute={a.attribute?.slug ?? ''}
>
  <div class="card-top">
    {a.attribute && <IconSlot name={`attr-${a.attribute.slug}`} />}
    <div class="tags">
      <span class="lbl">{a.kind.name}</span>
      <span class="lbl">{a.rollLabel}</span>
    </div>
  </div>
  <h2 id={action.id}>{a.name}</h2>
  {a.notInUse && <p class="lbl unused">Not used in current rules</p>}
  <dl class="facts">
    <div><dt class="lbl">Gear</dt><dd><GlossText parts={gear} /></dd></div>
    {requires.length > 0 && (
      <div>
        <dt class="lbl">Requires</dt>
        <dd><ul>{requires.map((r) => <li><GlossText parts={r} /></li>)}</ul></dd>
      </div>
    )}
    {a.needs && <div><dt class="lbl">Needs</dt><dd><GlossText parts={needs} /></dd></div>}
    <div>
      <dt class="lbl">What it does</dt>
      <dd>{does.map((d) => <p><GlossText parts={d} /></p>)}</dd>
    </div>
    {a.help && <div><dt class="lbl">Help</dt><dd><GlossText parts={help} /></dd></div>}
  </dl>
  <div class="card-foot">
    {a.diceTalents.length > 0 && (
      <div class="talent-links">
        <p class="lbl">Dice Talents</p>
        <ul class="tlist">{a.diceTalents.map((t) => <li><a href={`/compendium/talents/#${t.slug}`}>{t.name}</a>{t.condition && <span class="cond">, {t.condition}</span>}</li>)}</ul>
      </div>
    )}
    {a.ruleTalents.length > 0 && (
      <div class="talent-links">
        <p class="lbl">Rule Talents</p>
        <ul class="tlist">{a.ruleTalents.map((t) => <li><a href={`/compendium/talents/#${t.slug}`}>{t.name}</a></li>)}</ul>
      </div>
    )}
    {a.diceTalents.length + a.ruleTalents.length === 0 && <p class="lbl">No Talent names it</p>}
    <p class="lbl">Full rules: {pages.map((p, i) => <Fragment>{i > 0 && ', '}<a href={p.href}>{p.label}</a></Fragment>)}</p>
  </div>
</article>

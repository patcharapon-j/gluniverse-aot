---
import { facesHtml } from '~/lib/dice';

interface Props {
  /** The figure number in the page's sequence. */
  fig?: string;
}
const { fig = 'Fig. 1' } = Astro.props;

const decideIcon =
  '<svg viewBox="0 0 28 28" aria-hidden="true"><path d="M4 14h8l8-8m-8 8 8 8" fill="none" stroke="#29241D" stroke-width="1.8"/><path d="M17 4h5v5M17 24h5v-5" fill="none" stroke="#29241D" stroke-width="1.8"/></svg>';

const STEPS = [
  {
    title: 'Roll.',
    mini: facesHtml('base:6,2|stress:4'),
    text: 'Roll your pool and count every 6 as a success.',
    exit: { kind: 'stop', label: 'Stop', text: 'A Stress Die shows a 1: you suffer a Stress Response and cannot Push.' },
  },
  {
    title: 'Decide.',
    mini: decideIcon,
    text: 'Keep what you rolled, or Push. A comrade nearby may Cover you before any die is rolled again.',
    exit: { kind: 'note', label: 'Keep', text: 'The roll stands. You are done.' },
  },
  {
    title: 'Take the Stress.',
    mini: facesHtml('stress:+'),
    text: 'Gain 1 Stress and add 1 new Stress Die to your pool.',
    exit: { kind: 'cover', label: 'Covered', text: 'Your comrade gains the Stress instead, and no new Stress Die is added.' },
  },
  {
    title: 'Roll again.',
    mini: facesHtml('base:6k,?|stress:?|gear:1l'),
    text: 'Pick up every base die and Stress Die not showing a 6, plus the new Stress Die, and roll them. Dice showing 6 stay.',
    exit: { kind: 'note', label: 'Gear Dice', text: 'Never rolled again. They keep whatever they showed.' },
  },
  {
    title: 'Check your Stress Dice.',
    mini: facesHtml('stress:1x'),
    text: 'If any Stress Die now shows a 1, you suffer a Stress Response.',
    exit: { kind: 'stop', label: 'Limit', text: 'A roll never causes more than one Stress Response.' },
  },
];
---
<figure class="drawing wide" aria-labelledby="fig-push-caption">
  <ol class="flow">
    {STEPS.map((step, i) => (
      <li class="station">
        <span class="callout" aria-hidden="true">{i + 1}</span>
        <h4>{step.title}</h4>
        <div class="mini" aria-hidden="true" set:html={step.mini}></div>
        <p>{step.text}</p>
        <div class:list={['exit', `exit--${step.exit.kind}`]}>
          <b>{step.exit.label}<span class="sr">: </span></b>{step.exit.text}
        </div>
      </li>
    ))}
  </ol>
  <figcaption class="titleblock" id="fig-push-caption"><span>{fig}</span><span>The Push</span></figcaption>
</figure>

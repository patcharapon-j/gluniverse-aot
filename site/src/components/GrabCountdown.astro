---
/**
 * The Grab countdown: the two deadlines, counted in the Grabbed soldier's own turns.
 * The moments come from the Grab table (lib/engagement-tables), so a change there
 * redraws the clock.
 */
import IconSlot from './IconSlot.astro';
import { Icon } from 'astro-icon/components';
import { grabCountdown } from '~/lib/engagement-tables';

interface Props {
  fig: string;
}
const { fig } = Astro.props;
const clock = grabCountdown();
if (clock.crushLocation !== 'torso') throw new Error('GrabCountdown: the crush no longer lands on the torso.');

const MARKS = [
  {
    kind: 'land',
    label: 'The Grab lands',
    icon: 'ph:hand-grabbing',
    slot: null as string | null,
    text: 'Its hand closes: you are Grabbed and hold On Body relative to it. A crushing Critical Injury to the torso that cannot be lethal. It takes your Attention and every witness makes a Fear Roll.',
    note: 'No Help, no Covering, no Reactions. Your move changes nothing, and Break Free is your only action. You can still Push.',
  },
  {
    kind: 'turn',
    label: 'Your first counted turn',
    icon: 'ph:number-circle-one',
    slot: null,
    text: 'The Grab spends this turn’s action, dodge or no dodge. A dodge that spent a later turn gets that turn back, so dodging never costs you more than standing still.',
    note: null,
  },
  {
    kind: 'deadline',
    label: `Lifted, ${clock.lift}`,
    icon: null,
    slot: 'harm-critical-injury',
    text: 'If you are still Grabbed, it raises you toward its mouth. Lifting harms nothing, but from here Break Free and Pry Loose take a 2-die penalty, and only a comrade at On Body or Blind Spot can reach the arm.',
    note: null,
  },
  {
    kind: 'turn',
    label: 'Your second counted turn',
    icon: 'ph:number-circle-two',
    slot: null,
    text: 'Your last chance. Break Free, or a comrade frees you, or the Titan is stopped.',
    note: null,
  },
  {
    kind: 'devour',
    label: `Devoured, ${clock.devour}`,
    icon: null,
    slot: 'harm-death-roll',
    text: 'If you are still Grabbed, it devours you. You die, and every witness makes a Fear Roll.',
    note: null,
  },
];
---
<figure class="drawing wide grabfig" aria-labelledby="fig-grab-caption">
  <p class="lead">
    The countdown counts <b>your own turns</b>, not rounds. A turn spent in advance counts, and so does a turn taken while Down.
    While the Titan holds you, each of its cards resolves nothing and its next move waits.
  </p>

  <ol class="clock">
    {MARKS.map((mark) => (
      <li class:list={['mark', `mark--${mark.kind}`]}>
        <span class="pip" aria-hidden="true">
          {mark.slot ? <IconSlot name={mark.slot} size="sm" /> : mark.icon ? <Icon name={mark.icon} /> : null}
        </span>
        <h3>{mark.label}</h3>
        <p>{mark.text}</p>
        {mark.note && <p class="aside">{mark.note}</p>}
      </li>
    ))}
  </ol>

  <p class="foot">Freed at any point before the end of a counted turn, that turn's deadline never comes. Neither the lift nor the devour is a Titan attack: they roll nothing, and no Reaction answers either.</p>

  <figcaption class="titleblock" id="fig-grab-caption"><span>{fig}</span><span>The Grab countdown</span></figcaption>
</figure>

<style>
  .grabfig .lead {
    margin: 0 0 18px;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-3);
  }
  .clock {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mark {
    position: relative;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 2px 16px;
    padding: 10px 0 12px 0;
  }
  .mark::before {
    content: "";
    position: absolute;
    left: 16px;
    top: 0;
    bottom: 0;
    border-left: 1.5px solid var(--ink);
  }
  .mark:first-child::before {
    top: 24px;
  }
  .mark:last-child::before {
    bottom: auto;
    height: 24px;
  }
  .pip {
    position: relative;
    z-index: 1;
    grid-column: 1;
    grid-row: 1 / span 3;
    align-self: start;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
    background: var(--paper);
    box-shadow: 0 0 0 3px var(--paper);
  }
  .pip :global(svg) {
    width: 20px;
    height: 20px;
  }
  .mark--deadline .pip,
  .mark--devour .pip {
    border-width: 2px;
    border-color: var(--seal);
  }
  .mark h3,
  .mark p {
    grid-column: 2;
  }
  .mark h3 {
    font-family: var(--f-type);
    font-weight: 700;
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding-top: 9px;
  }
  .mark--deadline h3,
  .mark--devour h3 {
    color: var(--seal);
  }
  .mark p {
    margin-top: 3px;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .mark .aside {
    padding-left: 12px;
    border-left: 2px solid var(--rule);
    color: var(--ink-2);
    font-size: var(--fs-sm);
  }
  .foot {
    margin: 14px 0 26px;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-3);
  }
</style>

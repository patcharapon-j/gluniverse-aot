---
/**
 * The shape of the Position map, one drawing per shape of ground.
 *
 * Every node and every link is derived from the Anchor Ratings table's own step rows
 * (lib/engagement-tables, positionShapes), so a drawing can never show a route the rules do not
 * have. Change a step row and the picture changes with it.
 */
import { positionShapes } from '~/lib/engagement-tables';

interface Props {
  fig: string;
}
const { fig } = Astro.props;
const shapes = positionShapes();

const CHIP_W = 116;
const CHIP_H = 30;
const HALF = CHIP_W / 2;

interface Placed {
  id: string;
  name: string;
  x: number;
  y: number;
}

/**
 * Where each node sits, from the shape the table names. Any other shape has no drawing.
 * `slots` is how many stops the row is spaced for, which is one more than the nodes on ground
 * that reaches no Blind Spot, so the missing stop has its place kept.
 */
function place(shape: string, nodes: { id: string; name: string }[], slots: number): { placed: Placed[]; width: number; height: number; spare?: { x: number; y: number } } {
  const width = 560;
  if (shape === 'chain') {
    const gap = (width - 128) / (slots - 1);
    const y = 46;
    return {
      width,
      height: 92,
      placed: nodes.map((n, i) => ({ ...n, x: 64 + i * gap, y })),
      spare: slots > nodes.length ? { x: 64 + nodes.length * gap, y } : undefined,
    };
  }
  if (shape === 'branch') {
    const columns: Record<string, { x: number; y: number }> = {
      distant: { x: 64, y: 74 },
      'in-reach': { x: 248, y: 74 },
      'on-body': { x: 452, y: 36 },
      'blind-spot': { x: 452, y: 112 },
    };
    return {
      width,
      height: 152,
      placed: nodes.map((n) => {
        const at = columns[n.id];
        if (!at) throw new Error(`Position maps: a branching ground reaches "${n.id}", which the drawing has no column for.`);
        return { ...n, ...at };
      }),
    };
  }
  throw new Error(`Position maps: the table names a shape, "${shape}", the drawing cannot lay out.`);
}

/** The widest map sets the spacing, so every drawing on the page lines up stop for stop. */
const SLOTS = Math.max(...shapes.map((s) => s.nodes.length));

const drawings = shapes.map((shape) => {
  const { placed, width, height, spare } = place(shape.shape, shape.nodes, SLOTS);
  const at = new Map(placed.map((p) => [p.id, p]));
  const links = shape.links.map((link) => {
    const a = at.get(link.from)!;
    const b = at.get(link.to)!;
    return { a, b, from: a.name, to: b.name };
  });
  // Open ground reaches no Blind Spot at all, and the gap is the point: keep its place, struck out.
  const missing = shape.reachesBlindSpot ? null : (spare ?? null);
  return { ...shape, placed, links, width, height, missing };
});
---
<figure class="drawing wide posshapes" aria-labelledby="fig-position-shapes-caption">
  <p class="lead">
    The ground decides the shape of the map. How many stops there are, whether they branch, and whether you can get behind the thing at all.
  </p>

  <ol class="maps">
    {drawings.map((map) => (
      <li class="map">
        <div class="head">
          <h3>{map.name}</h3>
          <span class="lbl anch">{map.anchors} {map.anchors === '1' ? 'Anchor' : 'Anchors'}</span>
        </div>

        <svg
          class="shape"
          viewBox={`0 0 ${map.width} ${map.height}`}
          role="img"
          aria-label={`${map.name}: ${map.placed.map((p) => p.name).join(', ')}, joined by ${map.links.map((l) => `${l.from} to ${l.to}`).join(', ')}.${map.reachesBlindSpot ? '' : ' There is no Blind Spot on this ground while the Titan stands.'}`}
        >
          <g class="links">
            {map.links.map((l) => <line x1={l.a.x} y1={l.a.y} x2={l.b.x} y2={l.b.y} />)}
          </g>
          {map.missing && (
            <g class="gone">
              <line
                x1={map.placed[map.placed.length - 1].x}
                y1={map.missing.y}
                x2={map.missing.x}
                y2={map.missing.y}
              />
              <rect x={map.missing.x - HALF} y={map.missing.y - CHIP_H / 2} width={CHIP_W} height={CHIP_H} rx="3" />
              <text x={map.missing.x} y={map.missing.y + 4}>No Blind Spot</text>
            </g>
          )}
          <g class="stops">
            {map.placed.map((p) => (
              <g class:list={['stop', p.id === 'blind-spot' && 'stop--nape']}>
                <rect x={p.x - HALF} y={p.y - CHIP_H / 2} width={CHIP_W} height={CHIP_H} rx="3" />
                <text x={p.x} y={p.y + 4}>{p.name}</text>
              </g>
            ))}
          </g>
        </svg>

        <p class="says">{map.says}</p>
        <p class="lbl grounds">On {map.ratings.length === 1 ? 'this ground' : 'these grounds'}: {map.ratings.map((r) => r.replace(/-/g, ' ')).join(', ')}</p>
      </li>
    ))}
  </ol>

  <p class="foot">
    <b>A grounded Titan changes every map.</b> Break one of its legs and it comes down, so every step
    among In Reach, On Body and Blind Spot can be made on foot, and none of them mounted. On Open
    ground a grounded Titan finally gives you a Blind Spot to work from, which is the only way a Nape
    is cut on a plain. When it stands again, a soldier who was at its Blind Spot there holds On Body
    instead. A corpse counts as grounded for as long as it lies there.
  </p>

  <figcaption class="titleblock" id="fig-position-shapes-caption"><span>{fig}</span><span>The shape of the map, by the ground you fight on</span></figcaption>
</figure>

<style>
  .posshapes .lead {
    margin: 0 0 20px;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-3);
  }
  .maps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 26px;
  }
  .map + .map {
    padding-top: 22px;
    border-top: 1px dashed var(--rule);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
    margin-bottom: 10px;
  }
  .head h3 {
    margin: 0;
    font-family: var(--f-type);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .anch {
    color: var(--ink-2);
  }
  .shape {
    display: block;
    width: 100%;
    height: auto;
    max-width: 640px;
  }
  .links line {
    stroke: var(--ink);
    stroke-width: 1.6;
  }
  .stops rect {
    fill: var(--paper-hi);
    stroke: var(--ink);
    stroke-width: 1.3;
  }
  .stop--nape rect {
    stroke: var(--seal);
    stroke-width: 1.8;
  }
  .stop--nape text {
    fill: var(--seal);
  }
  .stops text,
  .gone text {
    font-family: var(--f-type);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-anchor: middle;
    fill: var(--ink);
  }
  .gone line {
    stroke: var(--rule);
    stroke-width: 1.4;
    stroke-dasharray: 5 5;
  }
  .gone rect {
    fill: none;
    stroke: var(--rule);
    stroke-width: 1.3;
    stroke-dasharray: 5 5;
  }
  .gone text {
    fill: var(--ink-2);
  }
  .says {
    margin: 12px 0 4px;
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .grounds {
    margin: 0;
    color: var(--ink-2);
    text-transform: capitalize;
  }
  .foot {
    margin: 22px 0 26px;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-3);
  }

  @media (max-width: 560px) {
    .shape {
      /* Below this width the chips would set type smaller than the page allows. */
      min-width: 320px;
    }
    .map {
      overflow-x: auto;
    }
  }
</style>

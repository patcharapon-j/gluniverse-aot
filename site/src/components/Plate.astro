---
/**
 * A full-colour plate mounted with a paper border and caption (ADR-0023).
 * The default slot holds placeholder art; `art` names the illustration that
 * will replace it, so a later art pass can find every frame.
 */
interface Props {
  number: string;
  caption: string;
  /** Describes the scene for screen readers. */
  label: string;
  art: string;
  ratio?: string;
  seal?: boolean;
}
const { number, caption, label, art, ratio = '5 / 4', seal = false } = Astro.props;
---
<figure class="plate" data-art-slot={art}>
  {seal && <svg class="seal" aria-hidden="true"><use href="#seal" /></svg>}
  <div class="plate-frame">
    <div class="plate-art" role="img" aria-label={label} style={`aspect-ratio:${ratio}`}>
      <slot>
        <svg viewBox="0 0 400 320" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <rect width="400" height="320" fill="#34483D" />
          <polygon points="40,0 170,0 330,320 190,320" fill="#F2E6C4" opacity=".08" />
          <path d="M0 200 Q80 176 160 190 T320 180 T400 188 V320 H0Z" fill="#26362D" />
          <g fill="#0E1511" opacity=".85"><ellipse cx="300" cy="150" rx="22" ry="28" /><path d="M262 214 Q268 180 300 176 Q334 180 340 214Z" /></g>
          <rect x="0" y="214" width="400" height="106" fill="#18221D" />
          <g stroke="#2E3F36" stroke-width="1"><path d="M0 238H400M0 262H400M0 286H400M0 310H400" /></g>
          <rect width="400" height="320" fill="url(#hlines)" opacity=".55" />
        </svg>
      </slot>
    </div>
  </div>
  <figcaption class="lbl"><span>{number}</span><em>{caption}</em></figcaption>
</figure>

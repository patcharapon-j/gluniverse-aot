---
/**
 * A core rules table, rendered from the shared tables through lib/core-tables.
 * Rows stack into labelled cards on narrow screens.
 */
import { getCollection } from 'astro:content';
import { bonusDiceSources, PAGE_ANCHORS, rollExceptions, stressChanges, type CoreTableData, type SeeRef } from '~/lib/core-tables';

interface Props {
  table: 'stress-changes' | 'bonus-dice' | 'roll-exceptions';
}
const { table } = Astro.props;

const builders: Record<Props['table'], () => CoreTableData> = {
  'stress-changes': stressChanges,
  'bonus-dice': bonusDiceSources,
  'roll-exceptions': rollExceptions,
};
const data = builders[table]();
const chapters = new Map((await getCollection('rules')).map((entry) => [entry.id, entry.data.title]));

function link(ref: SeeRef): { href: string; label: string } {
  if (ref.startsWith('#')) {
    const label = PAGE_ANCHORS[ref];
    if (!label) throw new Error(`CoreTable: no label for the anchor "${ref}".`);
    return { href: ref, label };
  }
  const title = chapters.get(ref);
  if (!title) throw new Error(`CoreTable: no Player's Guide chapter "${ref}".`);
  return { href: `/guide/${ref}/`, label: title };
}

for (const group of data.groups) {
  for (const row of group.rows) {
    if (row.cells.length !== data.columns.length - 1) throw new Error(`CoreTable: a "${data.caption}" row has the wrong number of cells.`);
  }
}
---
<div class="coretable wide">
  <table>
    <caption>
      <span class="lbl">Table</span>
      <b>{data.caption}</b>
      {data.note && <span class="note">{data.note}</span>}
    </caption>
    <thead>
      <tr>{data.columns.map((column) => <th scope="col">{column}</th>)}</tr>
    </thead>
    {data.groups.map((group) => (
      <tbody>
        {group.heading && (
          <tr class="group">
            <th scope="rowgroup" colspan={data.columns.length}>{group.heading}</th>
          </tr>
        )}
        {group.rows.map((row) => (
          <tr>
            {row.cells.map((cell, i) =>
              i === 0 ? <th scope="row" data-label={data.columns[i]}>{cell}</th> : <td data-label={data.columns[i]}>{cell}</td>,
            )}
            <td class="see" data-label={data.columns[data.columns.length - 1]}>
              {row.see.map(link).map((l, i) => (
                <>{i > 0 && <span class="sep">, </span>}<a href={l.href}>{l.label}</a></>
              ))}
            </td>
          </tr>
        ))}
      </tbody>
    ))}
  </table>
</div>

<style>
  table {
    width: 100%;
    border-collapse: collapse;
    border-bottom: 2px solid var(--ink);
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  caption {
    caption-side: top;
    text-align: left;
    padding-bottom: 10px;
  }
  caption .lbl {
    display: inline-block;
    margin-right: 10px;
    padding: 1px 6px;
    border: 1px solid var(--ink-2);
    color: var(--ink-2);
    font-size: var(--fs-2xs);
  }
  caption b {
    font-family: var(--f-type);
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  caption .note {
    display: block;
    margin-top: 6px;
    font-style: italic;
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  thead th {
    padding: 8px 10px;
    text-align: left;
    font-family: var(--f-type);
    font-size: var(--fs-2xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  tbody th,
  tbody td {
    padding: 9px 10px;
    text-align: left;
    vertical-align: top;
    border-top: 1px solid rgba(156, 144, 120, 0.6);
  }
  tbody th[scope="row"] {
    font-weight: 600;
  }
  .group th {
    padding: 6px 10px;
    font-family: var(--f-type);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--corps);
    background: rgba(207, 195, 165, 0.35);
    border-top: 1px solid var(--ink);
  }
  .see a {
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    table,
    caption,
    tbody,
    tr,
    th,
    td {
      display: block;
    }
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    tbody tr {
      padding: 10px 0;
      border-top: 1px solid rgba(156, 144, 120, 0.6);
    }
    tbody tr.group {
      padding: 0;
      border-top: 0;
    }
    tbody th,
    tbody td {
      padding: 2px 0;
      border-top: 0;
    }
    .group th {
      margin-top: 10px;
      padding: 6px 8px;
      border-top: 1px solid var(--ink);
    }
    tbody td::before {
      content: attr(data-label);
      display: block;
      margin-top: 6px;
      font-family: var(--f-type);
      font-size: var(--fs-2xs);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink-2);
    }
    .see a {
      white-space: normal;
    }
  }
</style>

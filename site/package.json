{
  "name": "wings-of-freedom-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.10.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "astro dev --port 4321",
    "sync-check": "node scripts/check-sync.mjs",
    "build": "node scripts/check-sync.mjs && astro build && pagefind --site dist",
    "preview": "astro preview --port 4321",
    "check": "astro check",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.1",
    "@fontsource/big-shoulders-stencil": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@fontsource/spectral": "5.3.0",
    "@iconify-json/ph": "1.2.2",
    "astro": "7.3.2",
    "astro-icon": "1.2.0",
    "cannon-es": "0.20.0",
    "three": "0.186.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "22.20.2",
    "@types/three": "0.186.0",
    "pagefind": "1.5.2",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
